# Configuração do docker compose (copie para .env; o .env é ignorado pelo git).
# Os segredos de cada serviço continuam nos .env deles:
#   backend/WorkoutOrganizer.Api/.env  (Jwt__Key)
#   document-service/.env              (OPENROUTER_API_KEY)

# Porta do gateway nginx no host. 80 já está ocupada no servidor.
NGINX_PORT=8080

# WorkoutOrganizer API — configuração local (copie para .env; o .env é ignorado pelo git).
# Formato Secao__Chave: cada linha sobrescreve a chave correspondente do appsettings.json.
# Variáveis de ambiente reais têm precedência sobre este arquivo.

# Chave de assinatura dos JWT: base64 de >= 32 bytes aleatórios. Gere uma com:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(64)).decode())"
Jwt__Key=

# URL do document-service (importação de ficha). Só mude se ele rodar em outra porta/host.
DocumentService__BaseUrl=http://localhost:5200

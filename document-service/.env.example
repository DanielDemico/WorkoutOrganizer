# ==============================================================================
# WorkoutOrganizer - document-service configuration (Template)
# ==============================================================================

# OpenRouter API Key (obtenha em: https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modelo primário recomendado para visão/documentos (alta acurácia, multimodal, rápido e econômico)
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash

# Modelo de fallback em caso de indisponibilidade, timeout ou rate-limit (429/5xx)
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Metadados opcionais para identificação no OpenRouter
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=WorkoutOrganizer

# Configurações do servidor FastAPI
PORT=5200
HOST=0.0.0.0
